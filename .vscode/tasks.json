{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CI: validar repository-baseline localmente",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/validate-repository-baseline.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "CP-2A: validar Java 8 em massa",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build-cp-2a.sh",
      "args": [
        "--profile",
        "ci-h2",
        "--env",
        "${workspaceFolder}/.env"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "CP-2A: validar Java 8 com Oracle",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build-cp-2a.sh",
      "args": [
        "--profile",
        "oracle",
        "--env",
        "${workspaceFolder}/.env"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CP-2A: iniciar aplicação Java 8 com H2",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/smoke-wildfly9-datasource.sh",
      "args": [
        "--java",
        "8",
        "--profile",
        "ci-h2",
        "--env",
        "${workspaceFolder}/.env",
        "--war",
        "${workspaceFolder}/app/target/wildfly-migration.war",
        "--manual"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "CP-2A: validar Java 8 em massa"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "CP-2A: iniciar aplicação Java 8 com Oracle",
