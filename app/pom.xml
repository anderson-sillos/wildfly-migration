<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.com.asillos.migration</groupId>
  <artifactId>wildfly-migration-lab</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>war</packaging>

  <name>WildFly Migration Lab</name>
  <description>Aplicação evolutiva do baseline legado ao destino Jakarta EE.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <migration.build.directory>${project.basedir}/target</migration.build.directory>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <java.version.range>[17,18)</java.version.range>

    <jakarta.ee.web.api.version>8.0.0</jakarta.ee.web.api.version>
    <mybatis.version>3.5.19</mybatis.version>
    <slf4j.version>1.7.36</slf4j.version>
    <reflections.version>0.10.2</reflections.version>
    <xmlbeans.version>5.3.0</xmlbeans.version>
    <dom4j.version>2.2.0</dom4j.version>
  </properties>

  <dependencies>
    <!--
      O perfil padrão permanece como referência EE 8 para os gates históricos.
      O perfil cp-3e-jakarta11 fornece Jakarta EE 11 sem colocar APIs do
      servidor em WEB-INF/lib; o código web moderno é ativado no CP-3F.
    -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-web-api</artifactId>
      <version>${jakarta.ee.web.api.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Dependências modernizadas de forma incremental no gate Java 17. -->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
      <version>${mybatis.version}</version>
    </dependency>
    <!--
      Ponte temporária para os imports org.apache.log4j ainda existentes.
      O backend e a API SLF4J são fornecidos pelo WildFly 26.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>log4j-over-slf4j</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.reflections</groupId>
      <artifactId>reflections</artifactId>
      <version>${reflections.version}</version>
      <exclusions>
        <!-- A API SLF4J é fornecida pelo WildFly e fixada como provided. -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.xmlbeans</groupId>
      <artifactId>xmlbeans</artifactId>
      <version>${xmlbeans.version}</version>
    </dependency>
    <dependency>
      <groupId>org.dom4j</groupId>
      <artifactId>dom4j</artifactId>
      <version>${dom4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <directory>${migration.build.directory}</directory>
    <finalName>wildfly-migration</finalName>
    <pluginManagement>
      <plugins>
        <!--
          O Maven CLI executa o XMLBeans normalmente. Este metadata adicional
          informa ao m2e/JDT como executar o mesmo goal no workspace do VS
          Code e registrar target/generated-sources como fonte compilável.
          O plugin fica somente em pluginManagement e não altera o WAR.
        -->
        <plugin>
          <groupId>org.eclipse.m2e</groupId>
          <artifactId>lifecycle-mapping</artifactId>
          <version>1.0.0</version>
          <configuration>
            <lifecycleMappingMetadata>
              <pluginExecutions>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.apache.xmlbeans</groupId>
                    <artifactId>xmlbeans</artifactId>
                    <versionRange>[5.3.0,)</versionRange>
                    <goals>
                      <goal>compile</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <execute>
                      <runOnConfiguration>true</runOnConfiguration>
                      <runOnIncremental>true</runOnIncremental>
                    </execute>
                  </action>
                </pluginExecution>
              </pluginExecutions>
            </lifecycleMappingMetadata>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.0.0-M3</version>
        <executions>
          <execution>
            <id>enforce-java17-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.16]</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>${java.version.range}</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.3.2</version>
        <configuration>
          <failOnMissingWebXml>true</failOnMissingWebXml>
          <outputTimestamp>${project.build.outputTimestamp}</outputTimestamp>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.1.2</version>
      </plugin>
      <!--
        O XSD versionado é a fonte única dos tipos XMLBeans. O plugin 5.x
        regenera interfaces e o TypeSystemHolder em cada build; nada gerado
        deve ser mantido no controle de versão.
      -->
      <plugin>
        <groupId>org.apache.xmlbeans</groupId>
        <artifactId>xmlbeans</artifactId>
        <version>${xmlbeans.version}</version>
        <executions>
          <execution>
            <id>generate-pedido-xml-types</id>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <sourceDir>${project.basedir}/src/main/resources/xsd</sourceDir>
          <sourceSchemas>pedido-importacao-v1.xsd</sourceSchemas>
          <javaTargetDir>${migration.build.directory}/generated-sources</javaTargetDir>
          <classTargetDir>${migration.build.directory}/generated-resources</classTargetDir>
          <name>PedidoImportacao</name>
          <repackage>br.com.asillos.migration.metadata</repackage>
          <sourceOnly>true</sourceOnly>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>oracle</id>
      <properties>
        <java.version.range>[17,18)</java.version.range>
      </properties>
    </profile>
    <profile>
      <id>ci-h2</id>
      <properties>
        <!-- O doctor fixa Temurin 17.0.20+8 nos dois perfis do CP-3A. -->
        <java.version.range>[17,18)</java.version.range>
      </properties>
    </profile>
    <profile>
      <id>cp-3e-jakarta11</id>
      <!--
        O JDT usa o JDK selecionado no workspace para importar os profiles.
        A ativação por JDK 21 mantém Jakarta ativo no editor sem alterar os
        gates históricos executados com Java 17.
      -->
      <activation>
        <jdk>[21,22)</jdk>
      </activation>
      <properties>
        <jakarta.ee.web.api.version>11.0.0</jakarta.ee.web.api.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <java.version.range>[21,22)</java.version.range>
      </properties>
    </profile>
  </profiles>
</project>
