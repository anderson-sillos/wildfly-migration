<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure
    xmlns="urn:jboss:deployment-structure:1.3">
  <deployment>
    <!--
      Força os imports org.apache.log4j a usar a ponte empacotada no WAR,
      evitando o módulo Log4j 1 depreciado do WildFly 26.
    -->
    <exclusions>
      <module name="org.apache.log4j"/>
    </exclusions>
  </deployment>
</jboss-deployment-structure>
