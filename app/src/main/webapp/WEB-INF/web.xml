<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">
  <display-name>WildFly Migration Lab</display-name>

  <context-param>
    <param-name>org.apache.tiles.impl.BasicTilesContainer.DEFINITIONS_CONFIG</param-name>
    <param-value>/WEB-INF/tiles-defs.xml</param-value>
  </context-param>

  <filter>
    <filter-name>requestContext</filter-name>
    <filter-class>br.com.asillos.migration.web.RequestContextFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>requestContext</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <listener>
    <listener-class>org.apache.tiles.web.startup.TilesListener</listener-class>
  </listener>
  <listener>
    <listener-class>br.com.asillos.migration.web.MigrationContextListener</listener-class>
  </listener>

  <servlet>
    <servlet-name>health</servlet-name>
    <servlet-class>br.com.asillos.migration.web.HealthServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>pedidos</servlet-name>
    <servlet-class>br.com.asillos.migration.web.PedidoServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>preferencia</servlet-name>
    <servlet-class>br.com.asillos.migration.web.PreferenceServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>upload</servlet-name>
    <servlet-class>br.com.asillos.migration.web.UploadServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>xmlImport</servlet-name>
    <servlet-class>br.com.asillos.migration.web.XmlImportServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>health</servlet-name>
    <url-pattern>/health</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>pedidos</servlet-name>
    <url-pattern>/pedidos/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>preferencia</servlet-name>
    <url-pattern>/preferencia</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>upload</servlet-name>
    <url-pattern>/anexos/upload</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>xmlImport</servlet-name>
    <url-pattern>/pedidos/importar-xml</url-pattern>
  </servlet-mapping>

  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

  <welcome-file-list>
    <welcome-file>pedidos</welcome-file>
  </welcome-file-list>
</web-app>
