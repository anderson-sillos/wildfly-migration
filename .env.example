# Copy this file to .env and fill only the values required by the selected
# checkpoint. Never commit .env, credentials, wallets, JDK archives or drivers.

MIGRATION_CHECKPOINT=CP-1A
# From CP-1D onward, select ci-h2 or oracle explicitly with --profile.

# Network defaults. Legacy runtimes must remain bound to loopback.
LAB_BIND_ADDRESS=127.0.0.1
WILDFLY_HTTP_PORT=8080
WILDFLY_MANAGEMENT_PORT=9990

# Java 7u80 is proprietary and must be supplied outside this repository.
JAVA7_HOME=
JAVA7_ARCHIVE=
# Optional duplicate of the manifest value. It must match the checked-in digest.
JAVA7_ARCHIVE_SHA256=bad9a731639655118740bee119139c1ed019737ec802a630dd7ad7aab4309623
# Updated JKS truststore used only for HTTPS downloads made by Java 7.
JAVA7_TRUSTSTORE=

# Redistributable Java 7 used only by the ci-h2 profile.
JAVA7_PORTABLE_HOME=
JAVA7_PORTABLE_ARCHIVE=
JAVA7_PORTABLE_ARCHIVE_SHA256=8a7387c1ed151474301b6553c6046f865dc6c1e1890bcf106acc2780c55727c8

# CP-2A/CP-2B: Eclipse Temurin OpenJDK 8u492-b09.
# Origin:
# https://github.com/adoptium/temurin8-binaries/releases/download/jdk8u492-b09/OpenJDK8U-jdk_x64_linux_hotspot_8u492b09.tar.gz
JAVA8_HOME=
JAVA8_ARCHIVE=
JAVA8_ARCHIVE_SHA256=da257f161d7f8c6ca5b0e5d9e4090f65ac28c5e398072e68b8ae87988b1d1a2e
# CP-3A: Eclipse Temurin OpenJDK 17.0.20+8.
# Origin:
# https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.20%2B8/OpenJDK17U-jdk_x64_linux_hotspot_17.0.20_8.tar.gz
JAVA17_HOME=
JAVA17_ARCHIVE=
JAVA17_ARCHIVE_SHA256=be7668bc030d578b83d6d5ef9221d6d6729bbbca8cf94a7d52e16ac68b5a5a35
# OpenJDK distributions used by the later migration gates.
JAVA21_HOME=
JAVA21_ARCHIVE=
JAVA21_ARCHIVE_SHA256=
JAVA25_HOME=
JAVA25_ARCHIVE=
JAVA25_ARCHIVE_SHA256=

# CP-2C+: Apache Maven 3.9.16 (requires Java 8+).
# Origin:
# https://downloads.apache.org/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz
MAVEN_HOME=
MAVEN_ARCHIVE=
MAVEN_ARCHIVE_SHA256=80ffca22aed9e8b9713a232f3394fd81d7f20322df75efdb2b047dbd3e3a23bb

# Community WildFly distributions. Keep archives and expanded runtimes external.
WILDFLY9_HOME=
WILDFLY9_ARCHIVE=
# Optional duplicate of the manifest value. It must match the checked-in digest.
WILDFLY9_ARCHIVE_SHA256=74689569d6e04402abb7d94921c558940725d8065dce21a2d7194fa354249bb6
# CP-2B: WildFly comunitário 26.1.3.Final.
# Origin:
# https://github.com/wildfly/wildfly/releases/download/26.1.3.Final/wildfly-26.1.3.Final.tar.gz
WILDFLY26_HOME=
WILDFLY26_ARCHIVE=
WILDFLY26_ARCHIVE_SHA256=aadd317c62616f6b5735ae92151d06c1f03c46eba448958d982c61f02528ae59
WILDFLY41_HOME=
WILDFLY41_ARCHIVE=
WILDFLY41_ARCHIVE_SHA256=

# Oracle 19c is external. Values below are required only by checkpoints that
# execute database scenarios. The doctor checks presence but never prints them.
# Preferred JDBC Thin format using SERVICE_NAME:
#   jdbc:oracle:thin:@//HOST:PORT/SERVICE_NAME
# Example:
#   jdbc:oracle:thin:@//oracle19c.interna.local:1521/ORCLPDB1
# Full Oracle Net descriptor:
#   jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=HOST)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=SERVICE_NAME)))
# Legacy SID format, only when explicitly supplied by the DBA:
#   jdbc:oracle:thin:@HOST:PORT:SID
# Keep user and password in their separate variables; never include them in URL.
ORACLE_DB_URL=
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_WALLET=

# Oracle JDBC remains external and is provisioned as a WildFly module.
OJDBC7_JAR=
OJDBC7_SHA256=

# H2 is external runtime test infrastructure and must never enter the WAR.
H2_JAR=
H2_SHA256=3ad9ac4b6aae9cd9d3ac1c447465e1ed06019b851b893dd6a8d76ddb6d85bca6
