# Copy this file to .env and fill only the values required by the selected
# checkpoint. Never commit .env, credentials, wallets, JDK archives or drivers.

MIGRATION_CHECKPOINT=CP-1A

# Network defaults. Legacy runtimes must remain bound to loopback.
LAB_BIND_ADDRESS=127.0.0.1
WILDFLY_HTTP_PORT=8080
WILDFLY_MANAGEMENT_PORT=9990

# Java 7u80 is proprietary and must be supplied outside this repository.
JAVA7_HOME=
JAVA7_ARCHIVE=
# Optional duplicate of the manifest value. It must match the checked-in digest.
JAVA7_ARCHIVE_SHA256=bad9a731639655118740bee119139c1ed019737ec802a630dd7ad7aab4309623

# OpenJDK distributions used by the migration gates.
JAVA8_HOME=
JAVA8_ARCHIVE=
JAVA8_ARCHIVE_SHA256=
JAVA17_HOME=
JAVA17_ARCHIVE=
JAVA17_ARCHIVE_SHA256=
JAVA21_HOME=
JAVA21_ARCHIVE=
JAVA21_ARCHIVE_SHA256=
JAVA25_HOME=
JAVA25_ARCHIVE=
JAVA25_ARCHIVE_SHA256=

# Maven 3.8.9 is mandatory through CP-2B; CP-2C switches to Maven 3.9.16.
MAVEN_HOME=
MAVEN_ARCHIVE=
MAVEN_ARCHIVE_SHA256=3e4c68cdd70f96635e713f36c8fc3ea3182035245d3da2156576710ca0fe4b0c

# Community WildFly distributions. Keep archives and expanded runtimes external.
WILDFLY9_HOME=
WILDFLY9_ARCHIVE=
# Optional duplicate of the manifest value. It must match the checked-in digest.
WILDFLY9_ARCHIVE_SHA256=74689569d6e04402abb7d94921c558940725d8065dce21a2d7194fa354249bb6
WILDFLY26_HOME=
WILDFLY26_ARCHIVE=
WILDFLY26_ARCHIVE_SHA256=
WILDFLY41_HOME=
WILDFLY41_ARCHIVE=
WILDFLY41_ARCHIVE_SHA256=

# Oracle 19c is external. Values below are required only by checkpoints that
# execute database scenarios. The doctor checks presence but never prints them.
ORACLE_DB_URL=
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_WALLET=
