batch
/subsystem=logging/pattern-formatter=MIGRATION_PATTERN:add(pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p correlation=%X{correlationId} [%c] (%t) %s%e%n")
/subsystem=logging/console-handler=CONSOLE:write-attribute(name=named-formatter,value=MIGRATION_PATTERN)
/subsystem=logging/logger=br.com.asillos.migration:add(level=TRACE,use-parent-handlers=true)
/subsystem=logging/logger=br.com.asillos.migration.persistence:add(level=TRACE,use-parent-handlers=true)
/subsystem=logging/logger=org.apache.ibatis:add(level=TRACE,use-parent-handlers=true)
/subsystem=datasources/data-source=ExampleDS:remove
/subsystem=datasources/jdbc-driver=h2-cp3f:add(driver-name=h2-cp3f,driver-module-name=com.h2database.h2,driver-class-name=org.h2.Driver,driver-xa-datasource-class-name=org.h2.jdbcx.JdbcDataSource)
/subsystem=datasources/data-source=MigrationDS:add(jndi-name=java:/jdbc/MigrationDS,driver-name=h2-cp3f,connection-url="jdbc:h2:mem:migration;MODE=Oracle;DB_CLOSE_DELAY=-1",jta=false,use-java-context=true,min-pool-size=1,max-pool-size=5,pool-prefill=true,validate-on-match=true,background-validation=false,check-valid-connection-sql="SELECT 1",enabled=true)
/subsystem=ee/service=default-bindings:write-attribute(name=datasource,value=java:/jdbc/MigrationDS)
run-batch
